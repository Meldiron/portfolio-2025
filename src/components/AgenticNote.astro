---
import { Icon } from "astro-icon/components";
import { agenticNote } from "../config";

interface Props {
  questionnaireUrl?: string;
  class?: string;
}

const { questionnaireUrl, class: className } = Astro.props;
---

<section class:list={["px-6 mx-auto max-w-3xl w-full", className]}>
  <div class="rounded-xl liquid-glass px-5 py-4">
    <div class="flex items-start gap-3">
      <div class="mt-0.5 rounded-lg bg-violet-500/15 p-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="#a78bfa" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456ZM16.894 20.567 16.5 21.75l-.394-1.183a2.25 2.25 0 0 0-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 0 0 1.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 0 0 1.423 1.423l1.183.394-1.183.394a2.25 2.25 0 0 0-1.423 1.423Z" /></svg>
      </div>
      <div>
        <p class="text-lg font-medium text-white/80 mb-0.5">{agenticNote.title}</p>
        <p class="text-sm text-white/40">{agenticNote.body}</p>
        {
          questionnaireUrl && (
            <a
              href={questionnaireUrl}
              class="inline-flex mt-3 gap-1.5 items-center w-[fit-content] text-white/80 border-white/[0.1] hover:border-white/[0.2] hover:bg-white/[0.05] border rounded-lg text-sm py-1 px-2.5 transition-all"
            >
              <Icon name="mdi:comment-question-outline" size={14} />
              {agenticNote.questionnaireLabel}
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>
